# Plantilla de variables del frontend. Copiala a .env.local y completá los valores.
# Vite solo expone al navegador las variables que empiezan con VITE_.

# Client ID del registro DuocConecta-Web (el SPA). Es DISTINTO del de la API.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Scope de la API. Tiene que ser este y no "openid profile": si se piden solo los scopes
# de OIDC, Microsoft devuelve un ID token cuya audiencia es el SPA y el backend lo rechaza con 401.
VITE_AZURE_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# URL del BFF. En local es localhost:8080; desplegado, la del API Gateway.
VITE_BFF_URL=http://localhost:8080
